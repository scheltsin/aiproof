      "phase": "operation",
      "title_ru": "Регистрация всех запросов к модели и ответов модели",
      "title_en": "Log every model request and response",
      "checks": [
        "ledger.present",
        "ledger.verified",
        "ledger.covers_calls"
      ],
      "evidence": [
        "ledger/*.jsonl",
        "ledger-verify.json"
      ],
      "xref": {
        "iso42001": "A.6.2.6, A.8.x (monitoring)",
        "nist_ai_rmf": "MEASURE 2.x, MANAGE 4.1",
        "eu_ai_act": "Art. 12 (record-keeping)"
      }
    },
    {
      "id": "AI-OP-02",
      "phase": "operation",
      "title_ru": "Целостность и неизменность журналов событий ИИ",
      "title_en": "Tamper-evident event logs",
